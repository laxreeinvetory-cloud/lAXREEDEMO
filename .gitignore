# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# Ignore local-only scratch files matching `local-*`, but keep the
# src/lib/local-db.ts persistence layer (imported by src/lib/db.ts and
# required at build time even on Vercel where it is never executed).
local-*
!src/lib/local-db.ts
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Database (SQLite binary — must not be committed)
/db/*.db
/db/*.db-journal
# Local JSON file-based DB (runtime data from src/lib/local-db.ts — dev only)
/db/data/

# Agent scratch / tool output (local only)
/tool-results/
/agent-ctx/
/audit-screenshots/
# Dev scripts and uploads (not needed in production)
/.zscripts/
/upload/
